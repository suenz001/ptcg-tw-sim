rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helper：管理員判定 ────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suenz001@yahoo.com.tw';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── 玩家基本資料與登入追蹤 ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isSelf(userId) || isAdmin();
      match /decks/{deckId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) || isAdmin();
      }
      // v5.331：常用卡牌雲端同步 users/{uid}/favorites/cards（鏡射 decks 規則）
      match /favorites/{favId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) || isAdmin();
      }
    }

    // ── 意見回饋（v2.53 / v2.7：read 改 own-or-admin，update 限 admin 加 reply）──
    match /feedbacks/{feedbackId} {
      // v2.53 / v2.7：admin 全讀；玩家可讀「uid 對得上自己」或「deviceId 命中
      // 自己 client-generated UUID」（後者支援匿名跨 session 找回歷史）。
      // 安全考量：deviceId 是 client 隨機 UUID（crypto.randomUUID 等級），
      //   猜測機率極低；feedback 內容本身為玩家提交給管理員的訊息，敏感性低；
      //   queryByDeviceId 必須是已登入（auth != null）使用者才能發起。
      // 注意：rules 無法直接驗證 query 中的 deviceId 與 client 的 deviceId 一致，
      //   故此處只能要求 doc 有 deviceId 欄位 + 用戶已登入。實質保護來自 deviceId
      //   為長隨機 UUID 不可預測。
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.uid == request.auth.uid)
                  || (request.auth != null
                      && resource.data.deviceId is string
                      && resource.data.deviceId.size() >= 16);
      // create：任何人（含未登入）可送，content 字串長度 1~5000
      allow create: if request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 5000;
      // v2.53：update / delete 限 admin（admin 用後台 /admin/feedbacks 加 reply）
      allow update, delete: if isAdmin();
    }

    // ── 線上對戰房間 ──────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid in request.resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                    );

      // v2.52 / v2.73 / v2.81：stale 房間清理規則
      //   v2.52：lobby 房 + 10 分鐘無更新 → 任何 authed 用戶可刪
      //   v2.73：playing 房 + 5 分鐘無 heartbeat → 任何 authed 用戶可刪
      //   v2.81：⚠️ ended 房永久保留供 admin 後台查歷史對戰紀錄；
      //          原本「不分狀態 5min 任何人可刪」的條款移除
      allow delete: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                       || (
                          resource.data.status == 'lobby'
                          && resource.data.updatedAt < request.time - duration.value(10, 'm')
                       )
                       || (
                          resource.data.status == 'playing'
                          && resource.data.updatedAt < request.time - duration.value(5, 'm')
                       )
                    );

      allow read, write: if isAdmin();

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 50;
        allow update, delete: if isAdmin();
      }
    }
  }
}
