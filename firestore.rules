rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suenz001@yahoo.com.tw';
    }

    // ── 玩家基本資料與登入追蹤 ──────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();
      
      // 玩家的牌組
      match /decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // ── 意見回饋 ──────────────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      // 允許任何人（包含未登入）新增意見，但不能修改或刪除
      allow create: if true;
      // 只有管理員能讀取和管理
      allow read, update, delete: if isAdmin();
    }

    // ── 線上對戰房間 ──────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      // 任何已登入用戶可讀取（用來透過房號加入）
      allow read: if request.auth != null;
      allow read, write: if isAdmin();

      // 只有 host 可以建立房間
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.hostUid;

      // host 或 guest 可以更新（推送狀態、打出動作）
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.hostUid
                      || request.auth.uid == resource.data.guestUid
                      || (resource.data.status == 'waiting'
                          && resource.data.guestUid == null
                          && request.resource.data.guestUid == request.auth.uid)
                    );
    }
  }
}
