rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helper：管理員判定 ────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suenz001@yahoo.com.tw';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── 玩家基本資料與登入追蹤（v2.46：private — own-or-admin only）────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isSelf(userId) || isAdmin();

      // 玩家的牌組（v2.46：私人牌組）
      match /decks/{deckId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) || isAdmin();
      }
    }

    // ── 意見回饋 ──────────────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 5000;
      allow update, delete: if isAdmin();
    }

    // ── 線上對戰房間 ──────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid in request.resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                    );

      // v2.52：delete 增加「stale lobby 房間」規則 — 任何 authed 用戶可清理
      // 條件：status='lobby' 且 updatedAt 超過 10 分鐘 → 視為殭屍房間
      // 解決玩家直接關電腦/瀏覽器沒觸發 leaveRoom，房間 doc 永遠殘留問題
      allow delete: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                       || (
                          resource.data.status == 'lobby'
                          && resource.data.updatedAt < request.time - duration.value(10, 'm')
                       )
                    );

      allow read, write: if isAdmin();

      // ── 聊天訊息子集合 ───────────────────────────────────────────
      match /messages/{msgId} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 50;

        allow update, delete: if isAdmin();
      }
    }
  }
}
