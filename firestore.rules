rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suenz001@yahoo.com.tw';
    }

    // ── 玩家基本資料與登入追蹤 ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();

      // 玩家的牌組
      match /decks/{deckId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    // ── 意見回饋 ──────────────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      // 允許任何人（包含未登入）新增與讀取意見（暫時開放給後台無須登入）
      allow create, read: if true;
      // 只有管理員能修改或刪除
      allow update, delete: if isAdmin();
    }

    // ── 線上對戰房間（v2.269 重構：座位制 lobby）──────────────────────────
    match /rooms/{roomCode} {
      // 任何已登入用戶可讀取（看 lobby 列表 + 加入後讀房間狀態）
      allow read: if request.auth != null;
      allow read, write: if isAdmin();

      // 建立房間：只有自己（hostUid）可建
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.hostUid;

      // 更新：任何已登入用戶都可寫（client API 自己保護 seat 完整性）
      // 注意：這假設 client 端可信。多人惡意篡改場景下需要 Cloud Functions 介入；
      // 目前小社群信任模型下 acceptable。
      allow update: if request.auth != null;

      // 刪除：authed user 都可刪（v2.275 client 只在「最後一人離房」時呼叫；
      //   以及房主主動關房）
      allow delete: if request.auth != null;

      // ── 聊天訊息子集合（v2.272 Phase 2）──────────────────────────
      match /messages/{msgId} {
        // 讀：authed 都可讀（房間內任何人都看得到聊天）
        allow read: if request.auth != null;
        // 建立：authed 且 uid 必須等於自己（防止偽造他人發言）
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.uid;
        // 不允許 update / delete（保留訊息歷史）
        allow update, delete: if isAdmin();
      }
    }
  }
}
