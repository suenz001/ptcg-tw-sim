rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helper：管理員判定 ────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suenz001@yahoo.com.tw';
    }
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── 玩家基本資料與登入追蹤 ────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if isSelf(userId) || isAdmin();
      match /decks/{deckId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) || isAdmin();
      }
    }

    // ── 意見回饋（v2.53：read 改 own-or-admin，update 限 admin 加 reply）──
    match /feedbacks/{feedbackId} {
      // v2.53：玩家可讀自己提交的（uid 對得上）；admin 全讀
      allow read: if isAdmin()
                  || (request.auth != null
                      && resource.data.uid == request.auth.uid);
      // create：任何人（含未登入）可送，content 字串長度 1~5000
      allow create: if request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 5000;
      // v2.53：update / delete 限 admin（admin 用後台 /admin/feedbacks 加 reply）
      allow update, delete: if isAdmin();
    }

    // ── 線上對戰房間 ──────────────────────────────────────────────────────
    match /rooms/{roomCode} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid
                    && request.resource.data.memberUids is list
                    && request.auth.uid in request.resource.data.memberUids;

      allow update: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid in request.resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                    );

      // v2.52：stale lobby 房間任何 authed 用戶可清理
      allow delete: if request.auth != null && (
                       request.auth.uid in resource.data.memberUids
                       || request.auth.uid == resource.data.hostUid
                       || (
                          resource.data.status == 'lobby'
                          && resource.data.updatedAt < request.time - duration.value(10, 'm')
                       )
                    );

      allow read, write: if isAdmin();

      match /messages/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 50;
        allow update, delete: if isAdmin();
      }
    }
  }
}
