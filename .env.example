# v4.61 Oracle backend 切換用環境變數
# 預設不設 → main repo build 走 firebase（GitHub Pages 主力）
# 設為 oracle → 試營運分支用 Oracle API

# 後端模式：firebase（預設）或 oracle
# VITE_BACKEND_MODE=oracle

# Oracle API URL（cloudflared tunnel URL 或正式 domain）
# 注意：cloudflared quick tunnel URL 每次重啟會換，記得更新
# VITE_ORACLE_API_URL=https://necessarily-investment-hrs-delivering.trycloudflare.com
